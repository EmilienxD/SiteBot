{
  "name": "website-chatbot-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drop-in AI assistant for websites. Configure one file, mount one route, add one script tag.",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p e2e",
    "test": "vitest run --project=!live --project=!security-*",
    "test:security": "vitest run --project=security-*",
    "test:watch": "vitest --project=!live --project=!security-*",
    "test:live": "vitest run --project=live",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:update-snapshots": "playwright test -c e2e/playwright.config.ts --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "turbo run size",
    "check:packages": "node scripts/check-packages.mjs",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.104",
    "@ai-sdk/openai-compatible": "^2.0.78",
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "bootstrap": "^5.3.8",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.24",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "prettier": "./.prettierrc.json"
}
