{
  "name": "@sitebot/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The documentation site: guides, recipes, and a config reference generated from the schema.",
  "type": "module",
  "scripts": {
    "reference": "node scripts/config-reference.mjs",
    "reference:check": "node scripts/config-reference.mjs --check",
    "dev": "vitepress dev",
    "build": "node scripts/config-reference.mjs --check && vitepress build",
    "preview": "vitepress preview"
  },
  "dependencies": {
    "@sitebot/config": "workspace:*"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "yaml": "^2.6.1"
  }
}
