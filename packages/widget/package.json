{
  "name": "@sitebot/widget",
  "version": "0.0.0",
  "description": "The <site-chat> custom element: launcher + overlay panel, Preact in a closed shadow root. Layer 3, browser.",
  "type": "module",
  "sideEffects": [
    "./dist/sitebot.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/sitebot.mjs"
    },
    "./sitebot.js": "./dist/sitebot.js",
    "./package.json": "./package.json"
  },
  "browser": "./dist/sitebot.js",
  "module": "./dist/sitebot.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/sitebot.js",
  "jsdelivr": "./dist/sitebot.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@preact/signals": "^2.10.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@sitebot/config": "workspace:*",
    "jsdom": "^27.0.0",
    "rimraf": "^6.1.3",
    "size-limit": "^13.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "size-limit": [
    {
      "name": "launcher (initial)",
      "path": "dist/sitebot.js",
      "limit": "12 kB",
      "gzip": true
    },
    {
      "name": "total",
      "path": "dist/*.js",
      "limit": "25 kB",
      "gzip": true
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
