{
  "name": "@sitebot/config",
  "version": "0.1.0",
  "description": "Schema, loader and types for the SiteBot configuration file. Layer 1 — importable from the browser.",
  "homepage": "https://github.com/EmilienxD/SiteBot/tree/main/packages/config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmilienxD/SiteBot.git",
    "directory": "packages/config"
  },
  "bugs": {
    "url": "https://github.com/EmilienxD/SiteBot/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schema"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    },
    "./schema/chatbot.schema.json": "./schema/chatbot.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && node ./scripts/emit-json-schema.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist schema"
  },
  "dependencies": {
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "fast-check": "^4.3.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.5"
  }
}
