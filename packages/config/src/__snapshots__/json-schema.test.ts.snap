                  "minLength": 1,
                  "type": "string",
                },
                "module": {
                  "description": "For provider: custom — path to a module exporting a LanguageModel factory, e.g. ./providers/x.ts#factory",
                  "type": "string",
                },
                "provider": {
                  "description": "Model provider.",
                  "enum": [
                    "anthropic",
                    "openai",
                    "google",
                    "azure",
                    "bedrock",
                    "vertex",
                    "mistral",
                    "groq",
                    "openai-compatible",
                    "ollama",
                    "custom",
                  ],
                  "type": "string",
                },
                "temperature": {
                  "maximum": 2,
                  "minimum": 0,
                  "type": "number",
                },
                "timeoutMs": {
                  "default": 60000,
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer",
                },
                "topK": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer",
                },
                "topP": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number",
                },
              },
              "required": [
                "provider",
                "model",
              ],
              "type": "object",
            },
            "maxTokensPerDay": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
            "maxTokensPerSession": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer",
            },
            "maxUsdPerDay": {
              "exclusiveMinimum": 0,
              "type": "number",
            },
            "onExceeded": {
              "default": "message",
              "enum": [
                "message",
                "error",
                "degrade",
              ],
              "type": "string",
            },
            "resetHourUtc": {
              "default": 0,
              "maximum": 23,
              "minimum": 0,
              "type": "integer",
            },
          },
          "type": "object",
        },
        "maxRequestBytes": {
          "default": 262144,
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "piiPatterns": {
          "default": [],
          "items": {
            "enum": [
              "email",
              "phone",
              "creditcard",
              "iban",
              "ssn",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "publicKey": {
          "description": "Identifies this deployment to the widget. Not a secret — it grants nothing on its own.",
          "type": "string",
        },
        "rateLimit": {
          "additionalProperties": false,
          "default": {},
          "properties": {
            "perIp": {
              "default": "100/1h",
              "pattern": "^[1-9][0-9]*\\/[1-9][0-9]*[smhd]$",
              "type": "string",
            },
            "perSession": {
              "default": "30/5m",
              "pattern": "^[1-9][0-9]*\\/[1-9][0-9]*[smhd]$",
              "type": "string",
            },
            "store": {
              "default": "memory",
              "description": "memory is single-process only — use redis for multi-replica.",
              "enum": [
                "memory",
                "redis",
              ],
              "type": "string",
            },
          },
          "type": "object",
        },
        "redactPii": {
          "default": false,
          "type": "boolean",
        },
        "strictTools": {
          "default": false,
          "description": "Turns the "MCP import without \`allow\`" warning into an error.",
          "type": "boolean",
        },
        "trustProxy": {
          "anyOf": [
            {
              "const": false,
              "type": "boolean",
            },
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer",
            },
          ],
          "default": false,
          "description": "Hop count for X-Forwarded-For. false ignores the header entirely.",
        },
      },
      "type": "object",
    },
