{
  "name": "@sitebot/ingest",
  "version": "0.0.0",
  "description": "Crawler, extractor, chunker, embedder and store writer for the SiteBot knowledge index. Layer 3; Node only, except the edge-safe ./query entry.",
  "homepage": "https://github.com/EmilienxD/SiteBot/tree/main/packages/ingest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmilienxD/SiteBot.git",
    "directory": "packages/ingest"
  },
  "bugs": {
    "url": "https://github.com/EmilienxD/SiteBot/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query.d.ts",
        "default": "./dist/query.js"
      },
      "require": {
        "types": "./dist/query.d.cts",
        "default": "./dist/query.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@sitebot/config": "workspace:*",
    "@sitebot/core": "workspace:*",
    "ai": "^6.0.240"
  },
  "peerDependencies": {
    "@ai-sdk/google": "^3",
    "@ai-sdk/mistral": "^3",
    "@ai-sdk/openai": "^3",
    "@ai-sdk/openai-compatible": "^2",
    "@upstash/vector": "^1",
    "pg": "^8",
    "playwright": "^1.63.0",
    "sqlite-vec": "^0.1"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@upstash/vector": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.5"
  }
}
