{
  "name": "@sitebot/ingest",
  "version": "0.0.0",
  "description": "Crawler, extractor, chunker, embedder and store writer for the SiteBot knowledge index. Layer 3, Node only.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@sitebot/config": "workspace:*",
    "@sitebot/core": "workspace:*",
    "ai": "^6.0.240"
  },
  "peerDependencies": {
    "@ai-sdk/google": "^3",
    "@ai-sdk/mistral": "^3",
    "@ai-sdk/openai": "^3",
    "@ai-sdk/openai-compatible": "^3",
    "@upstash/vector": "^1",
    "pg": "^8",
    "sqlite-vec": "^0.1"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@upstash/vector": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
