{
  "name": "@sitebot/core",
  "version": "0.0.0",
  "description": "The SiteBot engine: providers, prompt composition, tools, agent loop, guards, streaming. Layer 2.",
  "homepage": "https://github.com/EmilienxD/SiteBot/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmilienxD/SiteBot.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/EmilienxD/SiteBot/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "pricing.json"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    },
    "./pricing.json": "./pricing.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sitebot/config": "workspace:*",
    "ai": "^6.0.240",
    "jose": "^6.2.7",
    "redis": "^6.2.0",
    "undici": "^5.29.0",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@ai-sdk/amazon-bedrock": "^4",
    "@ai-sdk/anthropic": "^3",
    "@ai-sdk/azure": "^3",
    "@ai-sdk/google": "^3",
    "@ai-sdk/google-vertex": "^4",
    "@ai-sdk/groq": "^3",
    "@ai-sdk/mistral": "^3",
    "@ai-sdk/openai": "^3",
    "@ai-sdk/openai-compatible": "^2",
    "@upstash/vector": "^1",
    "pg": "^8",
    "sqlite-vec": "^0.1.9"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/amazon-bedrock": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/azure": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/google-vertex": {
      "optional": true
    },
    "@ai-sdk/groq": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@upstash/vector": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.14",
    "@types/pg": "^8.23.1",
    "@upstash/vector": "^1.2.3",
    "pg": "^8.23.1",
    "rimraf": "^6.1.3",
    "sqlite-vec": "^0.1.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.5"
  }
}
