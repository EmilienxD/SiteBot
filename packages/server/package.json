{
  "name": "@sitebot/server",
  "version": "0.0.0",
  "description": "Thin framework adapters that mount the SiteBot engine on Next.js, Express, Fastify, Hono, Node or any fetch runtime. Layer 3.",
  "homepage": "https://github.com/EmilienxD/SiteBot/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmilienxD/SiteBot.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/EmilienxD/SiteBot/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fetch": {
      "import": {
        "types": "./dist/fetch.d.ts",
        "default": "./dist/fetch.js"
      },
      "require": {
        "types": "./dist/fetch.d.cts",
        "default": "./dist/fetch.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@sitebot/config": "workspace:*",
    "@sitebot/core": "workspace:*"
  },
  "peerDependencies": {
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.14",
    "@types/express": "^5.0.6",
    "ai": "^6.0.240",
    "express": "^5.2.1",
    "fastify": "^5.11.0",
    "hono": "^4.12.33",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.5"
  }
}
