{
  "name": "@sitebot/example-cloudflare-worker",
  "version": "0.0.0",
  "private": true,
  "description": "The chat API on Cloudflare Workers, with Upstash Vector for knowledge and KV for sessions.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-widget.mjs",
    "dev": "wrangler dev",
    "predeploy": "node scripts/copy-widget.mjs",
    "deploy": "wrangler deploy",
    "build:check": "node scripts/copy-widget.mjs && wrangler deploy --dry-run --outdir dist",
    "ingest": "sitebot ingest",
    "doctor": "sitebot doctor",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@sitebot/config": "workspace:*",
    "@sitebot/core": "workspace:*",
    "@sitebot/server": "workspace:*",
    "@sitebot/widget": "workspace:*",
    "@upstash/vector": "^1.2.3",
    "ai": "^6.0.240"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@sitebot/cli": "workspace:*",
    "@sitebot/ingest": "workspace:*",
    "typescript": "^5.9.3",
    "wrangler": "^4.138.0"
  }
}
