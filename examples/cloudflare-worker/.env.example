# Copy to .env.local for `pnpm ingest` and `pnpm doctor` — the CLI runs in
# Node and reads these from the environment. The Worker reads the same names
# from .dev.vars (see .dev.vars.example).
OPENAI_API_KEY=sk-...
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=...
