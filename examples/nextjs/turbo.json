{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "app/**",
        "lib/**",
        "scripts/**",
        "package.json",
        "chatbot.config.yaml",
        "chatbot.regex.yaml",
        "public-docs/**",
        ".sitebot/index.json",
        ".sitebot/text.json",
        "next.config.ts",
        "tsconfig.json"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
