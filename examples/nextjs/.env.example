# Copy to .env.local and fill only the provider used by your chosen config.
# chatbot.regex.yaml: server-only generation, no embedding key/model needed.
# GOOGLE_GENERATIVE_AI_API_KEY=
# SITEBOT_CONFIG=./chatbot.regex.yaml

# Default chatbot.config.yaml: one OpenAI key for chat and embeddings.
OPENAI_API_KEY=sk-...

# Optional: another OpenAI model for chat.
# SITEBOT_MODEL=gpt-5
